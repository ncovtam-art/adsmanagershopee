# Chạy npm run env:init để sinh mật khẩu Database development ngẫu nhiên.
# Không dùng giá trị ví dụ này cho production.
POSTGRES_USER=command_center
POSTGRES_PASSWORD=replace_with_random_local_password
POSTGRES_DB=command_center
DATABASE_URL=postgresql://command_center:replace_with_random_local_password@127.0.0.1:5432/command_center?schema=public
TEST_DATABASE_URL=postgresql://command_center:replace_with_random_local_password@127.0.0.1:5433/command_center_test?schema=public
APP_ORIGIN=https://shiny-potato-jrr9r995p76x25675-3000.app.github.dev
COOKIE_SECURE=true
META_REDIRECT_URI=https://shiny-potato-jrr9r995p76x25675-3000.app.github.dev/api/meta/callback
META_MOCK_ENABLED=false
DRY_RUN=true
META_APP_ID=1597178701849193
META_APP_SECRET=204b7ae03c5bd666ce16ce582771edfc
META_GRAPH_VERSION=26.0

# Redis development: cổng chỉ bind loopback, DB test khác app.
REDIS_URL=redis://127.0.0.1:6379/0
TEST_REDIS_URL=redis://127.0.0.1:6379/15
# Mặc định .cache/video-storage trong checkout; không đặt trong public/.
VIDEO_STORAGE_DIR=

# Ads Care poll interval; rules and Telegram sending remain disabled until explicitly enabled.
CARE_POLL_SECONDS=30
