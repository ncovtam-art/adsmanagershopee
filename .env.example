# ===== DATABASE — giữ nguyên giá trị hiện tại =====
POSTGRES_USER=command_center
POSTGRES_PASSWORD=tamdaominhtam
POSTGRES_DB=command_center

# Mật khẩu trong URL cần được URL-encode nếu có ký tự đặc biệt
DATABASE_URL=postgresql://command_center:<MAT_KHAU_DA_URL_ENCODE>@127.0.0.1:5432/command_center?schema=public
TEST_DATABASE_URL=postgresql://command_center:<MAT_KHAU_TEST_DA_URL_ENCODE>@127.0.0.1:5433/command_center_test?schema=public

# ===== APPLICATION =====
APP_ORIGIN=https://shiny-potato-jrr9r995p76x25675-3000.app.github.dev
COOKIE_SECURE=true

# ===== META — điền riêng, không gửi vào chat =====
META_APP_ID=1597178701849193
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_REDIRECT_URI=https://shiny-potato-jrr9r995p76x25675-3000.app.github.dev/api/meta/callback
META_MOCK_ENABLED=false

# Giữ đúng khóa cũ đã được kiểm tra OK, gồm 64 ký tự hex
